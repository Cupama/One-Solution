<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form_cupama" model="ir.ui.view">
        <field name="name">account.payment.form.cupama</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- #16: link the payment to the sales orders it pays -->
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="partner_type" invisible="1"/>
                <field name="sale_order_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       domain="[('state', '=', 'sale'), ('partner_id', 'child_of', partner_id)]"
                       invisible="payment_type != 'inbound' or partner_type != 'customer'"/>
                <field name="lock_sale_order"
                       invisible="payment_type != 'inbound' or partner_type != 'customer' or not sale_order_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
