<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_cupama" model="ir.ui.view">
        <field name="name">stock.picking.form.cupama</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- #17: identify additional deliveries -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="is_additional_delivery" invisible="not is_additional_delivery"/>
                <field name="additional_delivery_reason" invisible="not is_additional_delivery"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_internal_search_cupama" model="ir.ui.view">
        <field name="name">stock.picking.search.cupama</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[1]" position="before">
                <filter string="Additional Deliveries" name="additional_deliveries"
                        domain="[('is_additional_delivery', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
