<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- #15: which open quotes reserve this product -->
    <record id="product_template_form_view_cupama" model="ir.ui.view">
        <field name="name">product.template.form.cupama</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_quote_reservations" type="object"
                        class="oe_stat_button" icon="fa-bookmark"
                        groups="sales_team.group_sale_salesman"
                        invisible="quote_reservation_count == 0">
                    <field name="quote_reservation_count" widget="statinfo" string="Reserved (Quotes)"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
