<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_cupama" model="res.groups.privilege">
        <field name="name">Cupama</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_can_delete" model="res.groups">
        <field name="name">Can Delete Records</field>
        <field name="privilege_id" ref="res_groups_privilege_cupama"/>
        <field name="comment">Members can delete contacts, products, quotations, purchase orders, invoices, payments and transfers. Everyone else must archive.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Settings administrators keep the right implicitly. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('cupama_security.group_can_delete'))]"/>
    </record>

</odoo>
