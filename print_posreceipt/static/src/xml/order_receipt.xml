<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Cupama / Babo custom POS receipt.

        Extends the standard Odoo 19 receipt (point_of_sale.OrderReceipt):
          * adds a company header block with a hard-coded address per company,
            phone, BRN (company_registry) and the VAT number;
          * shows a "Vat Invoice" header for every company except Babo Cupama;
          * replaces the standard company footer block to avoid duplicating the
            address/VAT taken from the company record;
          * adds the exchange-policy note at the bottom of the receipt.

        The order lines, taxes, totals, payments, change and discounts keep the
        standard rendering, which already covers what the old v15 receipt did.
    -->
    <t t-name="print_posreceipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- Company header, right after the standard receipt header. -->
        <xpath expr="//ReceiptHeader" position="after">
            <div class="pos-receipt-contact text-center pt-2">
                <div class="pos-receipt-company-name fw-bolder" t-esc="order.company.name"/>
                <t t-if="order.company.name == 'Babo Cupama Household Co Ltd'">
                    <div>114, Royal-Road, Beau-Bassin</div>
                </t>
                <t t-else="">
                    <div>468 Bissoondoyal Avenue, La Caverne, Vacoas</div>
                </t>
                <div t-if="order.company.phone">Tel: <t t-esc="order.company.phone"/></div>
                <div t-if="order.company.company_registry">Brn: <t t-esc="order.company.company_registry"/></div>
                <t t-if="order.company.name != 'Babo Cupama Household Co Ltd'">
                    <div>VAT: 28047271</div>
                    <div class="fw-bolder pt-1">Vat Invoice</div>
                </t>
            </div>
        </xpath>

        <!-- The standard company address/VAT footer block would duplicate the
             header above, so remove it. -->
        <xpath expr="//div[@class='d-flex gap-2 pt-3']" position="replace"/>

        <!-- Exchange policy note. -->
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <div class="thank-note text-center pt-3">
                <div>Any valid exchange will be considered upon presentation of this receipt within 7 days of purchase</div>
            </div>
        </xpath>

    </t>

</templates>
