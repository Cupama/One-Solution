<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_whatsapp" model="ir.ui.view">
        <field name="name">account.move.form.whatsapp</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <button name="action_invoice_sent" position="after">
                <button name="action_open_whatsapp" string="WhatsApp" type="object"
                        icon="fa-whatsapp"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'"/>
            </button>
        </field>
    </record>
</odoo>
