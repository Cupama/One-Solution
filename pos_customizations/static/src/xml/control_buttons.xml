<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Only show the Refund button to users in `group_allow_refund`. -->
    <t t-name="pos_customizations.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[@t-on-click='() => this.clickRefund()']" position="attributes">
            <attribute name="t-if">this.pos.cashier._role != 'minimal' and refundAccess.allowed</attribute>
        </xpath>
    </t>

</templates>
