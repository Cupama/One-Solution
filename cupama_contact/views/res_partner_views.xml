<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_cupama" model="ir.ui.view">
        <field name="name">res.partner.form.cupama</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- #1: WhatsApp number just before the phone -->
            <xpath expr="(//field[@name='phone'])[1]/.." position="before">
                <div class="d-flex align-items-baseline w-md-50">
                    <i class="fa fa-fw me-1 fa-whatsapp text-primary" title="WhatsApp"/>
                    <field name="whatsapp_number" class="w-100" widget="phone" placeholder="WhatsApp Number"/>
                </div>
            </xpath>

            <!-- #2 BRN / #6 ID Num, between the VAT Num and the Website.
                 The anchor is the website field, NOT the vat one: on the
                 production database a Studio/legacy view wraps the vat in an
                 inline container, and anything inserted next to it lands
                 inside that cell (label on the same line, no alignment).
                 The website field sits in a regular form group there, so
                 plain sibling fields get their automatic, aligned label. -->
            <xpath expr="//field[@name='website']" position="before">
                <field name="cupama_id_num" string="ID Num" invisible="is_company"
                       placeholder="e.g. A1234567890123"/>
                <field name="company_registry" string="BRN"
                       invisible="parent_id or not is_company"
                       placeholder="e.g. C07048459"/>
            </xpath>
            <!-- the native BRN node is removed from "Sales & Purchase / Misc"
                 so the field exists only once in the form -->
            <xpath expr="//group[@name='misc']/field[@name='company_registry']" position="replace"/>

        </field>
    </record>

</odoo>
