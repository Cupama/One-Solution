<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_cupama" model="ir.ui.view">
        <field name="name">res.partner.form.cupama</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- #1: WhatsApp number just before the phone -->
            <xpath expr="(//field[@name='phone'])[1]/.." position="before">
                <div class="d-flex align-items-baseline w-md-50">
                    <i class="fa fa-fw me-1 fa-whatsapp text-primary" title="WhatsApp"/>
                    <field name="whatsapp_number" class="w-100" widget="phone" placeholder="WhatsApp Number"/>
                </div>
            </xpath>

            <!-- The production database carries Studio/legacy partner views:
                 the vat field is not always a direct child of a form group
                 there, so the label of a field placed next to it is not
                 always generated. Hence the wide anchor (first vat of the
                 form, wherever it is) and the explicit <label/> elements,
                 which render in both a group and a plain container. -->

            <!-- #2: the BRN (moved from "Sales & Purchase / Misc", not
                 duplicated) shown right under the VAT Num. -->
            <xpath expr="//field[@name='vat']" position="after">
                <label for="company_registry" string="BRN" invisible="parent_id or not is_company"/>
                <xpath expr="//group[@name='misc']/field[@name='company_registry']" position="move"/>
            </xpath>
            <xpath expr="//field[@name='company_registry']" position="attributes">
                <attribute name="nolabel">1</attribute>
                <attribute name="string">BRN</attribute>
            </xpath>

            <!-- #6: ID Num for individuals, right under the VAT Num -->
            <xpath expr="//field[@name='vat']" position="after">
                <label for="cupama_id_num" string="ID Num" invisible="is_company"/>
                <field name="cupama_id_num" nolabel="1" invisible="is_company"
                       placeholder="e.g. A1234567890123"/>
            </xpath>

        </field>
    </record>

</odoo>
