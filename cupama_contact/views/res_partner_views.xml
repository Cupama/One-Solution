<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_cupama" model="ir.ui.view">
        <field name="name">res.partner.form.cupama</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- #1: WhatsApp number just before the phone -->
            <xpath expr="(//field[@name='phone'])[1]/.." position="before">
                <div class="d-flex align-items-baseline w-md-50">
                    <i class="fa fa-fw me-1 fa-whatsapp text-primary" title="WhatsApp"/>
                    <field name="whatsapp_number" class="w-100" widget="phone" placeholder="WhatsApp Number"/>
                </div>
            </xpath>

            <!-- The anchor is the group holding the website field, not just
                 //field[@name='vat']: a database may carry other views adding
                 a vat field elsewhere in the form, and the first match would
                 then drop our fields outside of the group (no label). -->

            <!-- #2: the BRN sits in the "Sales & Purchase / Misc" group by
                 default; Cupama uses it as often as the VAT Num, so the node
                 is moved right under it (moved, not duplicated). -->
            <xpath expr="//group[field[@name='website']]/field[@name='vat']" position="after">
                <xpath expr="//group[@name='misc']/field[@name='company_registry']" position="move"/>
            </xpath>
            <xpath expr="//group[field[@name='website']]/field[@name='company_registry']" position="attributes">
                <attribute name="string">BRN</attribute>
            </xpath>

            <!-- #6: ID Num for individuals, right under the VAT Num -->
            <xpath expr="//group[field[@name='website']]/field[@name='vat']" position="after">
                <field name="cupama_id_num" string="ID Num" invisible="is_company"
                       placeholder="e.g. A1234567890123"/>
            </xpath>

        </field>
    </record>

</odoo>
