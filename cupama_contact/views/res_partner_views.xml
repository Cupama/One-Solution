<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_cupama" model="ir.ui.view">
        <field name="name">res.partner.form.cupama</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- #1: WhatsApp number just before the phone -->
            <xpath expr="(//field[@name='phone'])[1]/.." position="before">
                <div class="d-flex align-items-baseline w-md-50">
                    <i class="fa fa-fw me-1 fa-whatsapp text-primary" title="WhatsApp"/>
                    <field name="whatsapp_number" class="w-100" widget="phone" placeholder="WhatsApp Number"/>
                </div>
            </xpath>

            <!-- The production partner form carries Studio/legacy views where
                 the vat field is inlined in a plain container, not a form
                 group: anything inserted next to it flows on the same line
                 and gets no automatic label. Each field is therefore shipped
                 in its own full-width block (w-100 forces its own line in a
                 flow container, colspan="2" keeps a full row in a standard
                 group) with an explicit label. -->

            <!-- #6: ID Num for individuals, on its own line under the VAT Num -->
            <xpath expr="//field[@name='vat']" position="after">
                <div class="w-100 d-flex align-items-baseline" colspan="2"
                     invisible="is_company">
                    <label for="cupama_id_num" string="ID Num"
                           class="o_form_label fw-bold text-nowrap me-3 mb-0"/>
                    <field name="cupama_id_num" nolabel="1" class="flex-grow-1"
                           placeholder="e.g. A1234567890123"/>
                </div>
            </xpath>

            <!-- #2: BRN on its own line under the VAT Num. A nested
                 position="move" is silently ignored inside new content, so
                 the block ships its own node and the native one is removed
                 from "Sales & Purchase / Misc" (the field exists only once). -->
            <xpath expr="//field[@name='vat']" position="after">
                <div class="w-100 d-flex align-items-baseline" colspan="2"
                     invisible="parent_id or not is_company">
                    <label for="company_registry" string="BRN"
                           class="o_form_label fw-bold text-nowrap me-3 mb-0"/>
                    <field name="company_registry" nolabel="1" class="flex-grow-1"
                           placeholder="e.g. C07048459"/>
                </div>
            </xpath>
            <xpath expr="//group[@name='misc']/field[@name='company_registry']" position="replace"/>

        </field>
    </record>

</odoo>
